+use std::sync::Mutex;
+
+use tokio_util::sync::CancellationToken;
+
+/// One CodeModeService's local admission boundary. No host RPC or global state.
+pub(super) struct CallbackAdmission {
+    state: Mutex<State>,
+}
+
+struct State {
+    token: CancellationToken,
+    interrupt_depth: usize,
+}
+
+/// Keeps admission closed across the explicit stop's awaits and concurrent starts.
+pub(super) struct CallbackInterrupt<'a> {
+    admission: &'a CallbackAdmission,
+    registered: bool,
+}
+
+impl Drop for CallbackInterrupt<'_> {
+    fn drop(&mut self) {
+        if !self.registered {
+            return;
+        }
+        match self.admission.state.lock() {
+            Ok(mut state) => {
+                state.interrupt_depth = state
+                    .interrupt_depth
+                    .checked_sub(1)
+                    .expect("registered callback interrupt must have a depth");
+                // Finishing the stop never itself reopens the revoked generation.
+            }
+            Err(poisoned) => poisoned.into_inner().token.cancel(),
+        }
+    }
+}
+
+impl Default for CallbackAdmission {
+    fn default() -> Self {
+        Self {
+            state: Mutex::new(State {
+                token: CancellationToken::new(),
+                interrupt_depth: 0,
+            }),
+        }
+    }
+}
+
+impl CallbackAdmission {
+    pub(super) fn snapshot(&self) -> CancellationToken {
+        match self.state.lock() {
+            Ok(state) => state.token.clone(),
+            Err(poisoned) => {
+                let state = poisoned.into_inner();
+                state.token.cancel();
+                state.token.clone()
+            }
+        }
+    }
+
+    pub(super) fn interrupt(&self) {
+        match self.state.lock() {
+            Ok(state) => state.token.cancel(),
+            Err(poisoned) => poisoned.into_inner().token.cancel(),
+        }
+    }
+
+    pub(super) fn begin_interrupt(&self) -> CallbackInterrupt<'_> {
+        let registered = match self.state.lock() {
+            Ok(mut state) => {
+                state.token.cancel();
+                state.interrupt_depth = state
+                    .interrupt_depth
+                    .checked_add(1)
+                    .expect("too many concurrent callback interrupts");
+                true
+            }
+            Err(poisoned) => {
+                poisoned.into_inner().token.cancel();
+                false
+            }
+        };
+        CallbackInterrupt {
+            admission: self,
+            registered,
+        }
+    }
+
+    pub(super) fn begin_task(&self) {
+        match self.state.lock() {
+            Ok(mut state) => {
+                if state.interrupt_depth == 0 && state.token.is_cancelled() {
+                    state.token = CancellationToken::new();
+                }
+            }
+            // Poison and an in-progress interrupt both keep admission closed.
+            Err(poisoned) => poisoned.into_inner().token.cancel(),
+        }
+    }
+}
+
