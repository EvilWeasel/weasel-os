+use std::future::Future;
+
+use tokio_util::sync::CancellationToken;
+
+/// Retain the originating exec task's stop boundary after its first response yields.
+///
+/// The host owns independent callback tokens. Cancelling that exact token wakes the
+/// existing nested ToolCallRuntime and its request-scoped MCP drop guard. A yield
+/// or an ordinary successful response does not cancel anything. Host-cell
+/// termination remains the separate CodeModeInterrupt policy.
+pub(super) async fn with_owner_cancellation<T>(
+    owner: &CancellationToken,
+    callback: CancellationToken,
+    cancelled_error: &'static str,
+    operation: impl Future<Output = Result<T, String>>,
+) -> Result<T, String> {
+    if owner.is_cancelled() {
+        callback.cancel();
+        return Err(cancelled_error.to_string());
+    }
+    tokio::select! {
+        biased;
+        _ = owner.cancelled() => {
+            // Revoke the already admitted callback before dropping its waiter.
+            // Its worker may outlive this future and must see the same token.
+            callback.cancel();
+            Err(cancelled_error.to_string())
+        }
+        result = operation => result,
+    }
+}
