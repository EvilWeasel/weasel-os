+        assert!(callback_readback.is_cancelled());
+        assert!(dropped.load(Ordering::SeqCst));
+    }
+    #[test]
+    fn start_holding_task_lock_cannot_reopen_while_interrupt_waits() {
+        let fence = CallbackAdmission::default();
+        let old = fence.snapshot();
+        // Deterministic actual source order: start holds active_turn lock;
+        // interrupt enters synchronously then awaits that lock; start hook runs.
+        let interrupt = fence.begin_interrupt();
+        fence.begin_task();
+        assert!(old.is_cancelled());
+        assert!(fence.snapshot().is_cancelled());
+        drop(interrupt);
+        assert!(fence.snapshot().is_cancelled());
+        // Only a task start after the interrupt lifetime may open a fresh token.
+        fence.begin_task();
+        assert!(old.is_cancelled());
+        assert!(!fence.snapshot().is_cancelled());
+    }
