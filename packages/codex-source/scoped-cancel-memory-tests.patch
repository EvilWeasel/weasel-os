+    fn overlapping_interrupts_and_dropped_interrupt_future_keep_fence_closed() {
+        let fence = CallbackAdmission::default();
+        let first = fence.begin_interrupt();
+        let second = fence.begin_interrupt();
+        drop(first);
+        fence.begin_task();
+        assert!(fence.snapshot().is_cancelled());
+        drop(second);
+        assert!(fence.snapshot().is_cancelled());
+        fence.begin_task();
+        assert!(!fence.snapshot().is_cancelled());
