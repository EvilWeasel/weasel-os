+    #[tokio::test]
+    async fn stop_after_initial_yield_revokes_pending_callback_and_drops_waiter() {
+        struct DropProbe(Arc<AtomicBool>);
+        impl Drop for DropProbe {
+            fn drop(&mut self) {
+                self.0.store(true, Ordering::SeqCst);
+            }
+        }
+        let owner = CancellationToken::new();
+        let callback = CancellationToken::new();
+        let dropped = Arc::new(AtomicBool::new(false));
+        let (admitted_tx, admitted_rx) = oneshot::channel();
+        let worker_owner = owner.clone();
+        let worker_callback = callback.clone();
+        let worker_dropped = Arc::clone(&dropped);
+        let callback_task = tokio::spawn(async move {
+            with_owner_cancellation(&worker_owner, worker_callback, CANCELLED, async {
+                let _waiter = DropProbe(worker_dropped);
+                admitted_tx.send(()).unwrap();
+                pending::<Result<(), String>>().await
+            })
+            .await
+        });
+        // Model the already-returned initial Yield: neither token is cancelled.
+        admitted_rx.await.unwrap();
+        assert!(!callback.is_cancelled());
+        assert!(!dropped.load(Ordering::SeqCst));
+        owner.cancel();
+        assert_eq!(
+            tokio::time::timeout(Duration::from_secs(1), callback_task)
+                .await
+                .unwrap()
+                .unwrap(),
+            Err(CANCELLED.to_string())
+        );
+        assert!(callback.is_cancelled());
+        assert!(dropped.load(Ordering::SeqCst));
+    }
