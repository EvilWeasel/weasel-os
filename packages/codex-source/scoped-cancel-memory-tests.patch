+#[cfg(test)]
+mod tests {
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use rmcp::{ErrorData, RoleClient, RoleServer, ServerHandler, ServiceExt};
+use rmcp::model::{CallToolRequest, CallToolRequestParams, CallToolResponse, CallToolResult,
+    CancelledNotificationParam, ClientRequest, RequestId, ServerResult};
+use rmcp::service::{NotificationContext, PeerRequestOptions, RequestContext, RequestHandle, RunningService};
+
+#[derive(Clone, Default)]
+struct State {
+    started: Arc<Mutex<Vec<(RequestId, String)>>>,
+    cancelled: Arc<Mutex<Vec<RequestId>>>,
+}
+#[derive(Clone)]
+struct FakeServer(State);
+impl ServerHandler for FakeServer {
+    async fn call_tool(&self, request: CallToolRequestParams, context: RequestContext<RoleServer>)
+        -> Result<CallToolResponse, ErrorData> {
+        self.0.started.lock().unwrap().push((context.id.clone(), request.name.to_string()));
+        match request.name.as_ref() {
+            "pending" => {
+                context.ct.cancelled().await;
+                Ok(CallToolResult::success(vec![]).into())
+            }
+            "error" => Err(ErrorData::internal_error("controlled fixture error", None)),
+            _ => Ok(CallToolResult::success(vec![]).into()),
+        }
+    }
+    async fn on_cancelled(&self, params: CancelledNotificationParam,
+        _context: NotificationContext<RoleServer>) {
+        if let Some(id) = params.request_id { self.0.cancelled.lock().unwrap().push(id); }
+    }
+}
+type Client = RunningService<RoleClient, ()>;
+type Server = RunningService<RoleServer, FakeServer>;
+async fn pair() -> (Client, Server, State) {
+    let state=State::default();
+    let (a,b)=tokio::io::duplex(4096);
+    let (server,client)=tokio::join!(FakeServer(state.clone()).serve(a), ().serve(b));
+    (client.unwrap(),server.unwrap(),state)
+}
+async fn request(client: &Client, name: &str) -> RequestHandle<RoleClient> {
+    client.send_request_with_option(
+        ClientRequest::CallToolRequest(CallToolRequest::new(CallToolRequestParams::new(name.to_owned()))),
+        PeerRequestOptions::no_options(),
+    ).await.unwrap()
+}
+async fn started(state: &State, id: &RequestId) {
+    tokio::time::timeout(Duration::from_secs(1), async {
+        while !state.started.lock().unwrap().iter().any(|(seen,_)| seen==id) {
+            tokio::time::sleep(Duration::from_millis(1)).await;
+        }
+    }).await.unwrap();
+}
+async fn cancelled(state: &State, id: &RequestId) {
+    tokio::time::timeout(Duration::from_secs(1), async {
+        while !state.cancelled.lock().unwrap().contains(id) {
+            tokio::time::sleep(Duration::from_millis(1)).await;
+        }
+    }).await.unwrap();
+    tokio::time::sleep(Duration::from_millis(20)).await;
+    assert_eq!(state.cancelled.lock().unwrap().iter().filter(|seen| *seen==id).count(),1);
+}
+async fn close(client: Client, server: Server) {
+    let _=client.cancel().await;
+    let _=server.cancel().await;
+}
+
+#[tokio::test]
+async fn original_sdk_awaiter_drop_sends_no_cancel() {
+    let (client,server,state)=pair().await;
+    let handle=request(&client,"pending").await;
+    let id=handle.id.clone();started(&state,&id).await;
+    let task=tokio::spawn(handle.await_response());
+    tokio::task::yield_now().await;task.abort();let _=task.await;
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    assert!(state.cancelled.lock().unwrap().is_empty());
+    close(client,server).await;
+}
+
+#[tokio::test]
+async fn guarded_task_abort_sends_one_scoped_cancel() {
+    let (client,server,state)=pair().await;
+    let handle=request(&client,"pending").await;
+    let id=handle.id.clone();started(&state,&id).await;
+    let task=tokio::spawn(super::await_tool_response(handle));
+    tokio::task::yield_now().await;task.abort();let _=task.await;
+    cancelled(&state,&id).await;
+    close(client,server).await;
+}
+
+#[tokio::test]
+async fn unpolled_guarded_future_drop_sends_one_cancel() {
+    let (client,server,state)=pair().await;
+    let handle=request(&client,"pending").await;
+    let id=handle.id.clone();started(&state,&id).await;
+    let future=super::await_tool_response(handle);drop(future);
+    cancelled(&state,&id).await;
+    close(client,server).await;
+}
+
+#[tokio::test]
+async fn outer_timeout_cancels_and_other_request_survives() {
+    let (client,server,state)=pair().await;
+    let handle=request(&client,"pending").await;
+    let id=handle.id.clone();started(&state,&id).await;
+    let task=tokio::spawn(async move {
+        tokio::time::timeout(Duration::from_millis(25),super::await_tool_response(handle)).await
+    });
+    let status=request(&client,"status").await;
+    assert!(matches!(super::await_tool_response(status).await, Ok(ServerResult::CallToolResult(_))));
+    assert!(task.await.unwrap().is_err());
+    cancelled(&state,&id).await;
+    // Same session remains usable after scoped cancellation.
+    let status=request(&client,"status").await;
+    assert!(matches!(super::await_tool_response(status).await, Ok(ServerResult::CallToolResult(_))));
+    assert_eq!(state.cancelled.lock().unwrap().len(),1);
+    close(client,server).await;
+}
+
+#[tokio::test]
+async fn terminal_success_disarms() {
+    let (client,server,state)=pair().await;
+    let handle=request(&client,"status").await;
+    assert!(super::await_tool_response(handle).await.is_ok());
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    assert!(state.cancelled.lock().unwrap().is_empty());
+    close(client,server).await;
+}
+
+#[tokio::test]
+async fn terminal_protocol_error_disarms() {
+    let (client,server,state)=pair().await;
+    let handle=request(&client,"error").await;
+    assert!(matches!(super::await_tool_response(handle).await,Err(rmcp::ServiceError::McpError(_))));
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    assert!(state.cancelled.lock().unwrap().is_empty());
+    close(client,server).await;
+}
+
+#[test]
+fn no_options_has_no_sdk_timeout() {
+    let options=PeerRequestOptions::no_options();
+    assert_eq!(options.timeout,None);
+    assert_eq!(options.max_total_timeout,None);
+    assert!(!options.reset_timeout_on_progress);
+}
+
+}
