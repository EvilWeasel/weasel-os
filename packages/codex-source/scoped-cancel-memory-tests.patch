+#[tokio::test]
+async fn interrupted_service_refuses_execute_before_host_initialization() {
+    let (session, turn) = make_session_and_context().await;
+    let service = &session.services.code_mode_service;
+    assert!(service.session.get().is_none());
+    let _interrupt = service.interrupt_callbacks();
+    let result = service
+        .execute(
+            codex_code_mode::ExecuteRequest {
+                tool_call_id: "must-not-reach-host".to_string(),
+                enabled_tools: Vec::new(),
+                source: "throw new Error('must not execute')".to_string(),
+                yield_time_ms: None,
+                max_output_tokens: None,
+            },
+            StepContext::for_test(Arc::new(turn)),
+            CancellationToken::new(),
+        )
+        .await;
+    assert!(matches!(result, Err(e) if e == "code mode callbacks are interrupted"));
+    assert!(service.session.get().is_none());
+}
