+    #[tokio::test]
+    async fn idle_stop_revokes_pending_completed_owner_before_any_host_reply() {
+        struct DropProbe(Arc<AtomicBool>);
+        impl Drop for DropProbe {
+            fn drop(&mut self) {
+                self.0.store(true, Ordering::SeqCst);
+            }
+        }
+        let fence = CallbackAdmission::default();
+        let old_cell = fence.snapshot();
+        let owner = CancellationToken::new();
+        let completed_owner = owner.child_token();
+        drop(owner); // ordinary successful turn completion must not cancel its children.
+        assert!(!completed_owner.is_cancelled());
+        let callback = CancellationToken::new();
+        let callback_readback = callback.clone();
+        let dropped = Arc::new(AtomicBool::new(false));
+        let worker_dropped = Arc::clone(&dropped);
+        let (admitted_tx, admitted_rx) = oneshot::channel();
+        let task = tokio::spawn(async move {
