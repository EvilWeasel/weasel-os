+#[tokio::test]
+async fn original_owner_stop_revokes_a_queued_callback_after_yield() {
+    let (session, turn) = make_session_and_context().await;
+    let broker = Arc::new(CodeModeDispatchBroker::new(
+        session.thread_id,
+        Default::default(),
+    ));
+    let owner = CancellationToken::new();
+    let callback_token = CancellationToken::new();
+    let delegate = CodeModeCellDelegate {
+        broker: Arc::clone(&broker),
+        step_context: StepContext::for_test(Arc::new(turn)),
+        owner_cancellation_token: owner.clone(),
+    };
+    let mut callback = delegate.invoke_tool(
+        CodeModeNestedToolCall {
+            cell_id: CellId::new("yielded-owner-cell".to_string()),
+            runtime_tool_call_id: "owned-callback".to_string(),
+            tool_name: ToolName::plain("pending_probe"),
+            tool_kind: CodeModeToolKind::Function,
+            input: None,
+        },
+        callback_token.clone(),
+    );
+    assert!(futures::poll!(callback.as_mut()).is_pending());
+    let queued = broker.dispatch_rx.try_recv().unwrap();
+    let DispatchMessage::InvokeTool {
+        cancellation_token: worker_token,
+        ..
+    } = queued
+    else {
+        panic!("expected a queued nested invocation");
+    };
+    assert!(!worker_token.is_cancelled());
+    owner.cancel();
+    assert!(matches!(
+        futures::poll!(callback.as_mut()),
+        std::task::Poll::Ready(Err(_))
+    ));
+    assert!(worker_token.is_cancelled());
+    assert!(callback_token.is_cancelled());
+}
