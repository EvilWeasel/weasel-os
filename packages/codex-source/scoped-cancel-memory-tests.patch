+    #[test]
+    fn normal_task_start_keeps_successful_prior_cells_admitted() {
+        let fence = CallbackAdmission::default();
+        let prior = fence.snapshot();
+        fence.begin_task();
+        let next = fence.snapshot();
+        assert!(!prior.is_cancelled());
+        assert!(!next.is_cancelled());
+        fence.interrupt();
+        assert!(prior.is_cancelled());
+        assert!(next.is_cancelled());
+    }
+
+    #[test]
+    fn idle_interrupt_latches_all_old_cells_and_future_admission() {
+        let fence = CallbackAdmission::default();
+        let first = fence.snapshot();
+        let second = fence.snapshot();
+        fence.interrupt();
+        assert!(first.is_cancelled());
+        assert!(second.is_cancelled());
+        assert!(fence.snapshot().is_cancelled());
+    }
+
+    #[test]
+    fn new_task_opens_only_new_generation_old_cells_stay_revoked() {
+        let fence = CallbackAdmission::default();
+        let old = fence.snapshot();
+        fence.interrupt();
+        fence.begin_task();
+        let fresh = fence.snapshot();
+        assert!(old.is_cancelled());
+        assert!(!fresh.is_cancelled());
+        fence.interrupt();
+        assert!(old.is_cancelled());
+        assert!(fresh.is_cancelled());
+    }
+
+    #[test]
+    fn interrupt_does_not_touch_a_different_service() {
+        let own = CallbackAdmission::default();
+        let foreign = CallbackAdmission::default();
+        let foreign_cell = foreign.snapshot();
+        own.interrupt();
+        assert!(!foreign_cell.is_cancelled());
+        assert!(!foreign.snapshot().is_cancelled());
+    }
+
+    #[test]
+    fn repeated_interrupt_never_reopens_admission() {
+        let fence = CallbackAdmission::default();
+        fence.interrupt();
+        fence.interrupt();
+        assert!(fence.snapshot().is_cancelled());
+    }
+
+    #[test]
+    fn poisoned_fence_refuses_read_and_restart() {
+        let fence = Arc::new(CallbackAdmission::default());
+        let poison = Arc::clone(&fence);
