{
  "search": {
    "whole_word": false
  },
  "terminal": {
    "font_size": 17.0
  },
  "scrollbar": {
    "show": "system"
  },
  "gutter": {
    "min_line_number_digits": 5
  },
  "relative_line_numbers": "enabled",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_family": "Monaspace Neon",
  "icon_theme": "Catppuccin Frappé",
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "base_keymap": "Cursor",
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Frappé",
  },
  "helix_mode": true,
  "which_key": {
    "enabled": true,
  },
  "agent": {
    "single_file_review": true,
    "show_turn_stats": true,
    "use_modifier_to_send": true,
    "favorite_models": [],
    "play_sound_when_agent_done": true,
    "model_parameters": [],
  },
  "format_on_save": "on",
  "languages": {
    "Nix": {
      "formatter": {
        "external": {
          "command": "nixfmt",
        },
      },
      "format_on_save": "on",
    },
  },
}
